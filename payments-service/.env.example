# Server Configuration
PORT=8083
HOST=0.0.0.0
RUST_LOG=info
RUST_BACKTRACE=1

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/petpay_payments

# JWT Configuration (for validating tokens from other services)
JWT_SECRET=your-jwt-secret-min-10-chars

# Payment Providers
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Identity Service (for email)
IDENTITY_SERVICE_URL=http://identity:3000
IDENTITY_SERVICE_API_KEY=your-identity-service-api-key

# Marketplace Service (for order validation)
MARKETPLACE_SERVICE_URL=http://marketplace:8080

# PDF Storage
PDF_STORAGE_PATH=/app/pdfs
