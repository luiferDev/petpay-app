{
  "version": 3,
  "name": "Petpay API Gateway (Development)",
  
  "extra_config": {
    "telemetry/logging": {
      "level": "DEBUG",
      "stdout": true,
      "syslog": false
    },
    "router": {
      "disable_access_log": false
    },
    "qos/ratelimit/global": {
      "max_rate": 10000,
      "burst": 200
    },
    "auth/validator": {
      "alg": "RS256",
      "jwk_url": "http://identity:3000/.well-known/jwks.json",
      "cache": true,
      "cache_duration": 60,
      "audience": ["petpay-api"],
      "issuer": "petpay-identity",
      "disable_jwk_security": true
    }
  },

  "endpoints": [
    {
      "endpoint": "/api/v1/auth/login",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/api/v1/auth/login",
          "host": ["http://identity:3000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/register",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/api/v1/auth/register",
          "host": ["http://identity:3000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/refresh",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/api/v1/auth/refresh",
          "host": ["http://identity:3000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/logout",
      "method": "POST",
      "backend": [
        {
          "url_pattern": "/api/v1/auth/logout",
          "host": ["http://identity:3000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/auth/users",
      "method": "GET",
      "extra_config": {
        "auth/validator": {
          "roles_key": "roles",
          "roles": ["admin"]
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/auth/users",
          "host": ["http://identity:3000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/bookings",
      "method": "GET",
      "extra_config": {
        "auth/validator": {
          "roles_key": "roles",
          "roles": ["user", "admin", "service_provider"]
        },
        "qos/ratelimit/proxy": {
          "max_rate": 100,
          "strategy": "token-bucket"
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/bookings",
          "host": ["http://bookings:8082"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/bookings",
      "method": "POST",
      "extra_config": {
        "auth/validator": {
          "roles_key": "roles",
          "roles": ["user", "admin"]
        },
        "qos/ratelimit/proxy": {
          "max_rate": 10,
          "strategy": "token-bucket"
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/bookings",
          "host": ["http://bookings:8082"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/bookings/{id}",
      "method": "GET",
      "extra_config": {
        "auth/validator": {
          "roles_key": "roles",
          "roles": ["user", "admin", "service_provider"]
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/bookings/{id}",
          "host": ["http://bookings:8082"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/bookings/{id}/status",
      "method": "PATCH",
      "extra_config": {
        "auth/validator": {
          "roles_key": "roles",
          "roles": ["service_provider", "admin"]
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/bookings/{id}/status",
          "host": ["http://bookings:8082"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/bookings/{id}",
      "method": "DELETE",
      "extra_config": {
        "auth/validator": {
          "roles_key": "roles",
          "roles": ["user", "admin"]
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/bookings/{id}",
          "host": ["http://bookings:8082"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/orders",
      "method": "GET",
      "extra_config": {
        "auth/validator": {
          "roles_key": "roles",
          "roles": ["user", "admin"]
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/orders",
          "host": ["http://marketplace:8080"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/orders",
      "method": "POST",
      "extra_config": {
        "auth/validator": {
          "roles_key": "roles",
          "roles": ["user", "admin"]
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/orders",
          "host": ["http://marketplace:8080"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/orders/{id}",
      "method": "GET",
      "extra_config": {
        "auth/validator": {
          "roles_key": "roles",
          "roles": ["user", "admin"]
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/orders/{id}",
          "host": ["http://marketplace:8080"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/marketplace/products",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/api/v1/marketplace/products",
          "host": ["http://marketplace:8080"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/marketplace/products",
      "method": "POST",
      "extra_config": {
        "auth/validator": {
          "roles_key": "roles",
          "roles": ["admin"]
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/marketplace/products",
          "host": ["http://marketplace:8080"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/products",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/api/v1/products",
          "host": ["http://catalog:8081"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/products/{id}",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/api/v1/products/{id}",
          "host": ["http://catalog:8081"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/categories",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/api/v1/categories",
          "host": ["http://catalog:8081"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/services",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/api/v1/services",
          "host": ["http://catalog:8081"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/services/{id}",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/api/v1/services/{id}",
          "host": ["http://catalog:8081"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/health",
      "method": "GET",
      "backend": [
        {
          "url_pattern": "/api/v1/health",
          "host": ["http://identity:3000"]
        }
      ]
    }
  ]
}
