generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model account_users {
  id               Int              @id @default(autoincrement())
  account_id       Int
  user_id          String           @db.VarChar(36)
  permission_level permission_level
  joined_at        DateTime         @default(now()) @db.Timestamptz(6)
  is_active        Boolean          @default(true)
  accounts         accounts         @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_users_account_id_accounts_id_fk")
  users            users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_users_user_id_users_id_fk")

  @@unique([account_id, user_id], map: "account_user_unique")
}

model accounts {
  id            Int             @id @default(autoincrement())
  account_name  String          @db.VarChar(255)
  account_type  account_type
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  account_users account_users[]
}

model addresses {
  id          Int      @id @default(autoincrement())
  user_id     String   @db.VarChar(36)
  street      String   @db.VarChar(255)
  city        String   @db.VarChar(100)
  state       String?  @db.VarChar(100)
  country     String   @db.VarChar(100)
  postal_code String?  @db.VarChar(20)
  latitude    Float?
  longitude   Float?
  is_primary  Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "addresses_user_id_users_id_fk")
}

model user_roles {
  user_id String @db.VarChar(36)
  role    role
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_roles_user_id_users_id_fk")

  @@id([user_id, role], map: "user_roles_user_id_role_pk")
}

model users {
  id            String          @id @db.VarChar(36)
  email         String          @unique(map: "users_email_unique") @db.VarChar(255)
  password_hash String          @db.VarChar(255)
  first_name    String          @db.VarChar(100)
  last_name     String          @db.VarChar(100)
  phone         String?         @db.VarChar(20)
  is_verified   Boolean         @default(false)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  account_users account_users[]
  addresses     addresses[]
  user_roles    user_roles[]

  @@index([email], map: "email_idx")
}

enum account_type {
  INDIVIDUAL
  FAMILY
  BUSINESS
}

enum permission_level {
  READ
  WRITE
  ADMIN
  OWNER
}

enum role {
  CLIENT
  SERVICE_PROVIDER
  ADMIN
}
